---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import TopicGrid from '../../components/topic/TopicGrid.astro';
import { safeFetch } from '../../lib/api/safe';
import { listTopics } from '../../lib/api/topics';

const topicsRes = await safeFetch(() => listTopics());
---

<BaseLayout
  title="Temas"
  description="Explora la biblioteca por tema: Eucaristía, María, Bautismo, Trinidad y más, con contenido de todas las categorías."
>
  <Breadcrumbs items={[{ name: 'Temas', href: '/temas' }]} />
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-serif text-3xl font-bold text-foreground">Temas</h1>
    <p class="mt-2 max-w-2xl font-sans text-muted-foreground">
      Cada tema reúne artículos de distintas secciones — para que profundices sin depender de una sola sección.
    </p>
    <div class="mt-8">
      <TopicGrid topics={topicsRes?.data ?? []} />
    </div>
  </div>
</BaseLayout>
