---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SeriesTimeline from '../../components/series/SeriesTimeline.astro';
import { getSeriesBySlug } from '../../lib/api/series';
import { ApiRequestError } from '../../lib/api/client';

const { slug } = Astro.params;

let series;
try {
  ({ data: series } = await getSeriesBySlug(slug!));
} catch (error) {
  if (error instanceof ApiRequestError && error.status === 404) {
    return Astro.rewrite('/404');
  }
  throw error;
}
---

<BaseLayout title={series.name} description={series.description ?? `Serie: ${series.name}`}>
  <Breadcrumbs items={[{ name: 'Series', href: '/series' }, { name: series.name, href: `/series/${series.slug}` }]} />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <p class="font-sans text-sm font-semibold uppercase tracking-wide text-accent">Serie</p>
    <h1 class="mt-1 font-serif text-3xl font-bold text-foreground">{series.name}</h1>
    {series.description && <p class="mt-3 font-sans text-muted-foreground">{series.description}</p>}
    <div class="mt-8">
      <SeriesTimeline series={series} />
    </div>
  </div>
</BaseLayout>
