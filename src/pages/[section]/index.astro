---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionHero from '../../components/section/SectionHero.astro';
import SectionArticles from '../../components/section/SectionArticles.astro';
import { listSections, listSectionArticles } from '../../lib/api/sections';

const { section: slug } = Astro.params;
const page = Number(Astro.url.searchParams.get('page') ?? '1');

const sectionsRes = await listSections();
const section = sectionsRes.data.find((item) => item.slug === slug);

if (!section) {
  return Astro.rewrite('/404');
}

const articlesRes = await listSectionArticles(slug!, page).catch(() => null);
---

<BaseLayout title={section.name} description={section.description ?? `Contenido de ${section.name}`}>
  <Breadcrumbs items={[{ name: section.name, href: `/${section.slug}` }]} />
  <SectionHero section={section} />
  <div class="mx-auto max-w-6xl px-4 py-10">
    <SectionArticles
      articles={articlesRes?.data ?? []}
      meta={articlesRes?.meta ?? { current_page: 1, last_page: 1, per_page: 12, total: 0 }}
      basePath={`/${section.slug}`}
    />
  </div>
</BaseLayout>
