---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SearchInput from '../../components/search/SearchInput';
import SearchResults from '../../components/search/SearchResults';

const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout title="Buscar" description="Busca artículos, temas, videos y recursos en la biblioteca católica.">
  <Breadcrumbs items={[{ name: 'Buscar', href: '/buscar' }]} />
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-serif text-3xl font-bold text-foreground">¿Qué deseas aprender?</h1>
    <div class="mt-6">
      <SearchInput mode="live" autoFocus={!initialQuery} client:load />
    </div>
    <div class="mt-8">
      <SearchResults initialQuery={initialQuery} client:load />
    </div>
  </div>
</BaseLayout>
