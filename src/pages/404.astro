---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

Astro.response.status = 404;
---

<BaseLayout title="No encontrado" description="No encontramos este contenido.">
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <p class="font-serif text-6xl font-bold text-primary">404</p>
    <h1 class="mt-4 font-serif text-2xl font-semibold text-foreground">No encontramos este contenido.</h1>
    <p class="mt-2 font-sans text-muted-foreground">Puede que el enlace haya cambiado o que el contenido ya no esté disponible.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/">Volver al inicio</Button>
      <Button href="/buscar" variant="secondary">Buscar</Button>
      <Button href="/explorar" variant="ghost">Explorar temas</Button>
    </div>
  </div>
</BaseLayout>
