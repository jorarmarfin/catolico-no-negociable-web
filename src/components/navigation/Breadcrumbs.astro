---
import JsonLd from '../seo/JsonLd.astro';
import { breadcrumbListJsonLd } from '../../lib/seo/jsonld';

export interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const withHome: Crumb[] = [{ name: 'Inicio', href: '/' }, ...items];
const jsonLdItems = withHome.map((item) => ({ name: item.name, url: new URL(item.href, Astro.site).toString() }));
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-6">
  <ol class="flex flex-wrap items-center gap-1 font-sans text-sm text-muted-foreground">
    {
      withHome.map((item, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          )}
          {index === withHome.length - 1 ? (
            <span aria-current="page" class="font-medium text-foreground">
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="transition-colors duration-200 hover:text-primary">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<JsonLd data={breadcrumbListJsonLd(jsonLdItems)} />
