---
import { Image } from 'astro:assets';
import MobileMenu from './MobileMenu';
import SearchInput from '../search/SearchInput';
import { safeFetch } from '../../lib/api/safe';
import { listSections } from '../../lib/api/sections';
import logo from '../../assets/logo.png';

const sectionsRes = await safeFetch(() => listSections());
const sections = sectionsRes?.data ?? [];

const primaryLinks = sections.slice(0, 4).map((section) => ({ href: `/${section.slug}`, label: section.name }));
const overflowLinks = sections.slice(4).map((section) => ({ href: `/${section.slug}`, label: section.name }));
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex items-center gap-2.5 font-serif text-lg font-semibold text-primary">
      <Image src={logo} alt="" width={36} height={36} class="h-9 w-9" />
      <span>Católico No Negociable</span>
    </a>

    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          primaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-lg px-3 py-2 font-sans text-sm font-medium text-foreground transition-colors duration-200 hover:bg-muted"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/temas" class="block rounded-lg px-3 py-2 font-sans text-sm font-medium text-foreground transition-colors duration-200 hover:bg-muted">
            Temas
          </a>
        </li>
        {
          overflowLinks.length > 0 && (
            <li>
              <a href="/explorar" class="block rounded-lg px-3 py-2 font-sans text-sm font-medium text-secondary transition-colors duration-200 hover:bg-muted">
                Más
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <div class="w-64">
        <SearchInput mode="redirect" client:load />
      </div>
    </div>

    <div class="flex items-center gap-1 md:hidden">
      <a
        href="/buscar"
        aria-label="Buscar"
        class="flex h-11 w-11 items-center justify-center rounded-lg text-foreground transition-colors duration-200 hover:bg-muted"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </a>
      <MobileMenu sections={sections} client:load />
    </div>
  </div>
</header>
