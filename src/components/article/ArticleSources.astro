---
import type { Source } from '../../types/taxonomy';
import { formatSourceType } from '../../lib/utils/format';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="mx-auto mt-10 max-w-prose border-t border-border pt-6">
      <h2 class="font-sans text-sm font-semibold uppercase tracking-wide text-secondary">Fuentes</h2>
      <ul class="mt-3 space-y-3">
        {sources.map((source) => (
          <li class="font-sans text-sm text-foreground">
            <p>
              {source.type && (
                <span class="mr-2 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">{formatSourceType(source.type)}</span>
              )}
              {source.url ? (
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="underline decoration-border underline-offset-2 hover:text-primary">
                  {source.title}
                </a>
              ) : (
                <span class="font-medium">{source.title}</span>
              )}
              {source.abbreviation && <span class="text-muted-foreground"> ({source.abbreviation})</span>}
              {source.reference && <span class="text-muted-foreground"> — {source.reference}</span>}
            </p>
            {source.quote && <blockquote class="mt-1 border-l-2 border-border pl-3 italic text-muted-foreground">«{source.quote}»</blockquote>}
            {source.context_note && <p class="mt-1 text-xs text-muted-foreground">{source.context_note}</p>}
          </li>
        ))}
      </ul>
    </section>
  )
}
