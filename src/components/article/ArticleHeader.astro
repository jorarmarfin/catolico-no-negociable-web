---
import type { Article } from '../../types/article';
import Badge from '../ui/Badge.astro';
import { formatDate, formatLevel } from '../../lib/utils/format';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const wasUpdated = article.updated_at !== article.published_at;
---

<header class="mx-auto max-w-prose">
  <div class="flex flex-wrap items-center gap-2">
    <Badge variant="accent">{article.section.name}</Badge>
    <Badge variant="muted">{formatLevel(article.level)}</Badge>
  </div>
  <h1 class="mt-3 font-serif text-3xl font-bold leading-tight text-foreground sm:text-4xl">
    {article.title}
  </h1>
  <p class="mt-3 font-sans text-lg text-muted-foreground">{article.excerpt}</p>

  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-sm text-muted-foreground">
    {article.author && <span>Por {article.author.name}</span>}
    {article.author && <span aria-hidden="true">·</span>}
    <time datetime={article.published_at}>Publicado el {formatDate(article.published_at)}</time>
    {
      wasUpdated && (
        <>
          <span aria-hidden="true">·</span>
          <time datetime={article.updated_at}>Actualizado el {formatDate(article.updated_at)}</time>
        </>
      )
    }
  </div>

  {
    article.featured_image && (
      <img
        src={article.featured_image}
        alt={article.featured_image_alt ?? ''}
        width="960"
        height="540"
        class="mt-6 aspect-video w-full rounded-xl object-cover"
      />
    )
  }
</header>
