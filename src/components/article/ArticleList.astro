---
import type { ArticleSummary } from '../../types/article';
import Badge from '../ui/Badge.astro';
import EmptyState from '../ui/EmptyState.astro';
import { formatDate } from '../../lib/utils/format';

interface Props {
  articles: ArticleSummary[];
  emptyMessage?: string;
}

const { articles, emptyMessage = 'Todavía no hay contenidos publicados aquí.' } = Astro.props;
---

{
  articles.length > 0 ? (
    <ul class="divide-y divide-border">
      {articles.map((article) => (
        <li>
          <a href={`/${article.section.slug}/${article.slug}`} class="flex flex-col gap-1 py-5 transition-colors duration-200 hover:text-primary sm:flex-row sm:items-center sm:justify-between">
            <div>
              <Badge variant="muted">{article.section.name}</Badge>
              <h3 class="mt-1 font-serif text-lg font-semibold text-foreground">{article.title}</h3>
              <p class="mt-1 font-sans text-sm text-muted-foreground">{article.excerpt}</p>
            </div>
            <time datetime={article.published_at} class="shrink-0 font-sans text-xs text-muted-foreground">
              {formatDate(article.published_at)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <EmptyState title={emptyMessage} />
  )
}
