---
interface Props {
  title: string;
  href?: string;
  hrefLabel?: string;
}

const { title, href, hrefLabel = 'Ver todo' } = Astro.props;
---

<div class="mb-6 flex items-end justify-between">
  <h2 class="font-serif text-2xl font-semibold text-foreground">{title}</h2>
  {
    href && (
      <a href={href} class="font-sans text-sm font-medium text-primary transition-colors duration-200 hover:underline">
        {hrefLabel} →
      </a>
    )
  }
</div>
