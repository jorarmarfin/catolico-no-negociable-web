---
import SearchInput from '../search/SearchInput';
import Button from '../ui/Button.astro';
---

<section class="border-b border-border bg-muted/40">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:py-24">
    <h1 class="font-serif text-4xl font-bold leading-tight text-foreground sm:text-5xl">
      Aprende, comprende y profundiza tu fe.
    </h1>
    <p class="mx-auto mt-4 max-w-xl font-sans text-lg text-muted-foreground">
      Catequesis, apologética, Biblia, doctrina y formación católica organizada para encontrar
      respuestas claras y confiables.
    </p>

    <div class="mx-auto mt-8 max-w-xl">
      <SearchInput mode="redirect" autoFocus client:load />
    </div>

    <div class="mt-6">
      <Button href="/explorar" variant="secondary">Explorar la biblioteca</Button>
    </div>
  </div>
</section>
