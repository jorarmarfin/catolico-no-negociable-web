---
import type { Topic } from '../../types/taxonomy';

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
---

<header class="border-b border-border bg-muted/40">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <p class="font-sans text-sm font-semibold uppercase tracking-wide text-accent">Tema</p>
    <h1 class="mt-1 font-serif text-3xl font-bold text-foreground sm:text-4xl">{topic.name}</h1>
    {topic.description && <p class="mt-3 max-w-2xl font-sans text-lg text-muted-foreground">{topic.description}</p>}
  </div>
</header>
