---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs, { type Crumb } from '../components/navigation/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  breadcrumbs?: Crumb[];
}

const { title, description, ogImage, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
  <div class="mx-auto max-w-6xl px-4 py-10">
    <slot />
  </div>
</BaseLayout>
